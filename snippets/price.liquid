{%- comment -%}
  Renders the selling price straight from Shopify product data. Nothing is hardcoded.

  Accepts:
  - product: product object
  - variant: variant object (optional, defaults to the selected or first available variant)
  - compare: comparison price in cents (optional). If omitted, the variant's own compare_at_price is used
    when the "show compare-at price" theme setting is on.
  - show_save: true to add a "Save $X" label (product page)
  - compact: true to show only the selling price (buttons)
  - class: extra class names
{%- endcomment -%}
{%- liquid
  assign price_variant = variant | default: product.selected_or_first_available_variant
  assign price_value = price_variant.price
  assign compare_value = 0
  if compare
    assign compare_value = compare
  elsif settings.show_compare_at_price
    assign compare_value = price_variant.compare_at_price
  endif
  assign has_compare = false
  assign save_cents = 0
  if compare_value > price_value
    assign has_compare = true
    assign save_cents = compare_value | minus: price_value
  endif
  assign save_amount = save_cents | money
-%}
<span class="pw-price {{ class }}" data-price-wrapper>
  <span class="pw-price__current" data-price>
    {%- if settings.show_currency_code -%}
      {{- price_value | money_with_currency -}}
    {%- else -%}
      {{- price_value | money -}}
    {%- endif -%}
  </span>
  {%- unless compact -%}
    <s class="pw-price__compare" data-compare-price{% unless has_compare %} hidden{% endunless %}>
      {%- if has_compare -%}{{ compare_value | money }}{%- endif -%}
    </s>
    {%- if show_save -%}
      <span class="pw-price__save" data-save{% unless has_compare %} hidden{% endunless %}>
        {%- if has_compare -%}{{ 'product.save' | t: amount: save_amount }}{%- endif -%}
      </span>
    {%- endif -%}
  {%- endunless -%}
</span>
