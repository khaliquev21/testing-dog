{%- comment -%}
  Inline SVG icons taken from the approved Pawora design.
  Colour comes from the surrounding CSS (currentColor).

  Accepts:
  - name: icon name
  - size: pixel size (default 20)
  - stroke: stroke width for outline icons (default 1.8)
  - class: extra class names
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_stroke = stroke | default: 1.8
  assign mode = 'stroke'
  capture inner
    case name
      when 'paw'
        assign mode = 'fill'
        echo '<ellipse cx="5.6" cy="9.4" rx="2" ry="2.6"></ellipse><ellipse cx="9.7" cy="5.4" rx="2" ry="2.6"></ellipse><ellipse cx="14.3" cy="5.4" rx="2" ry="2.6"></ellipse><ellipse cx="18.4" cy="9.4" rx="2" ry="2.6"></ellipse><path d="M12 11c-3 0-6.2 3.7-6.2 6.3 0 1.7 1.3 2.8 3 2.8 1.3 0 2.1-.6 3.2-.6s1.9.6 3.2.6c1.7 0 3-1.1 3-2.8C18.2 14.7 15 11 12 11z"></path>'
      when 'star'
        assign mode = 'fill'
        echo '<path d="M12 2.8l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.5l-5.8 3.1 1.1-6.4L2.6 9.6l6.5-.9z"></path>'
      when 'play'
        assign mode = 'fill'
        echo '<path d="M8 5.5v13l11-6.5z"></path>'
      when 'pause'
        assign mode = 'fill'
        echo '<path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z"></path>'
      when 'play-circle'
        echo '<circle cx="12" cy="12" r="9"></circle><path d="M10 8.5l5.5 3.5-5.5 3.5z" fill="currentColor"></path>'
      when 'search'
        echo '<circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path>'
      when 'bag'
        echo '<path d="M5 8h14l-1.2 12H6.2L5 8z"></path><path d="M9 8V6.5a3 3 0 016 0V8"></path>'
      when 'arrow-right'
        echo '<path d="M5 12h14M13 6l6 6-6 6"></path>'
      when 'check'
        echo '<path d="M5 12.5l4.5 4.5L19 7.5"></path>'
      when 'camera'
        echo '<path d="M3.5 8h3.5l2-3h6l2 3h3.5v11.5h-17z"></path><circle cx="12" cy="13.3" r="3.6"></circle>'
      when 'fur'
        echo '<path d="M3.5 7.5h17"></path><path d="M6 7.5v9.5M9.3 7.5v11M12.6 7.5v9.5M15.9 7.5v11M19 7.5v9.5"></path>'
      when 'refresh'
        echo '<path d="M19.5 11A7.5 7.5 0 006 6.6L4 8.5"></path><path d="M4 4.5v4h4"></path><path d="M4.5 13A7.5 7.5 0 0018 17.4l2-1.9"></path><path d="M20 19.5v-4h-4"></path>'
      when 'mist'
        echo '<path d="M8 20c-1.8-1.8 1.8-3.7 0-5.5s1.8-3.7 0-5.5S9.8 5.3 8 3.5"></path><path d="M12.5 20c-1.8-1.8 1.8-3.7 0-5.5s1.8-3.7 0-5.5 1.8-3.7 0-5.5"></path><path d="M17 20c-1.8-1.8 1.8-3.7 0-5.5s1.8-3.7 0-5.5 1.8-3.7 0-5.5"></path>'
      when 'drop'
        echo '<path d="M12 3.2s6.2 6.6 6.2 11.2a6.2 6.2 0 01-12.4 0C5.8 9.8 12 3.2 12 3.2z"></path><path d="M9 15a3 3 0 003 3"></path>'
      when 'truck'
        echo '<path d="M2.5 6.5h11v9h-11z"></path><path d="M13.5 9.5h4l3 3v3h-7z"></path><circle cx="6.5" cy="17.5" r="1.8"></circle><circle cx="16.5" cy="17.5" r="1.8"></circle>'
      when 'return'
        echo '<path d="M4 9h11a5 5 0 010 10H9"></path><path d="M8 5L4 9l4 4"></path>'
      when 'support'
        echo '<path d="M4 5h16v11H9l-5 4z"></path>'
      when 'chevron-left'
        echo '<path d="M15 5l-7 7 7 7"></path>'
      when 'chevron-down'
        echo '<path d="M5 9l7 7 7-7"></path>'
      when 'chevron-right'
        echo '<path d="M9 5l7 7-7 7"></path>'
      when 'minus'
        echo '<path d="M5 12h14"></path>'
      when 'plus'
        echo '<path d="M5 12h14M12 5v14"></path>'
      when 'menu'
        echo '<path d="M4 7h16M4 12h16M4 17h16"></path>'
      when 'close'
        echo '<path d="M6 6l12 12M18 6L6 18"></path>'
    endcase
  endcapture
-%}
{%- if mode == 'fill' -%}
  <svg class="pw-icon {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">{{ inner }}</svg>
{%- else -%}
  <svg class="pw-icon {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ inner }}</svg>
{%- endif -%}
