<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF7F2">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preload" href="{{ 'bricolage-grotesque-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'figtree-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <style>
      @font-face {
        font-family: 'Bricolage Grotesque';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url({{ 'bricolage-grotesque-latin.woff2' | asset_url }}) format('woff2');
      }
      @font-face {
        font-family: 'Figtree';
        font-style: normal;
        font-weight: 300 900;
        font-display: swap;
        src: url({{ 'figtree-latin.woff2' | asset_url }}) format('woff2');
      }
      :root {
        --btn-text: {{ settings.button_text_color | default: '#202020' }};
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Pawora = {
        cartType: {{ settings.cart_type | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartJson: {{ routes.cart_url | append: '.js' | json }}
        },
        strings: {
          addToCart: {{ 'product.add_to_cart' | t | json }},
          addedToCart: {{ 'product.added_to_cart' | t | json }},
          adding: {{ 'product.adding' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }},
          errorAdd: {{ 'product.error_generic' | t | json }},
          errorCart: {{ 'cart.error_generic' | t | json }},
          pause: {{ 'accessibility.pause_video' | t | json }},
          play: {{ 'accessibility.play_video' | t | json }},
          cartCount: {{ 'accessibility.cart_count' | t: count: '__COUNT__' | json }}
        }
      };
    </script>
  </head>

  <body class="pw-template-{{ template.name | handleize }}">
    <a class="pw-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="pw-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}
  </body>
</html>
