<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF7F2">
    <link rel="preload" href="{{ 'bricolage-grotesque-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'figtree-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <title>{{ shop.name }}</title>
    <style>
      @font-face {
        font-family: 'Bricolage Grotesque';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url({{ 'bricolage-grotesque-latin.woff2' | asset_url }}) format('woff2');
      }
      @font-face {
        font-family: 'Figtree';
        font-style: normal;
        font-weight: 300 900;
        font-display: swap;
        src: url({{ 'figtree-latin.woff2' | asset_url }}) format('woff2');
      }
      :root {
        --btn-text: {{ settings.button_text_color | default: '#202020' }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="pw-template-password">
    <main id="MainContent" class="pw-main pw-password" role="main">
      <div class="pw-password__inner">
        <span class="pw-logo pw-logo--lg">
          {% render 'icon', name: 'paw', size: 36 %}
          <span class="pw-logo__word">{{ settings.brand_name | default: shop.name }}</span>
        </span>
        <h1 class="pw-h2">{{ 'password.title' | t }}</h1>
        <p class="pw-lede">{{ 'password.text' | t }}</p>
        {{ content_for_layout }}
      </div>
    </main>
  </body>
</html>
