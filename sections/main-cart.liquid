<section class="pw-cartpage" data-section-id="{{ section.id }}">
  <div class="pw-cartpage__inner pw-container">
    <h1 class="pw-cartpage__title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="pw-cartpage__empty">
        <p class="pw-lede">{{ 'cart.empty_text' | t }}</p>
        {%- assign first_product = collections.all.products.first -%}
        <a class="pw-btn pw-btn--primary pw-btn--lg" href="{% if first_product != blank %}{{ first_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="pw-cartpage__form" id="CartPageForm">
        <ul class="pw-lines pw-lines--page">
          {%- for item in cart.items -%}
            <li class="pw-line" data-key="{{ item.key }}">
              <a class="pw-line__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image != blank -%}
                  {{
                    item.image
                    | image_url: width: 240
                    | image_tag: width: 120, height: 120, loading: 'lazy', alt: item.image.alt | default: item.product.title, class: 'pw-line__img'
                  }}
                {%- else -%}
                  {% render 'icon', name: 'paw', size: 32 %}
                {%- endif -%}
              </a>
              <div class="pw-line__body">
                <a class="pw-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="pw-line__variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <span class="pw-line__price">{{ item.final_price | money }}</span>
                <div class="pw-line__controls">
                  <label class="pw-visually-hidden" for="CartQty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                  <input
                    id="CartQty-{{ forloop.index }}"
                    class="pw-qtyfield"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    inputmode="numeric"
                  >
                  <a class="pw-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="pw-line__total">{{ item.final_line_price | money }}</div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="pw-cartpage__summary">
          <div class="pw-drawer__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="pw-drawer__subtotal-amount">{{ cart.total_price | money }}</span>
          </div>
          <p class="pw-drawer__note">{{ 'cart.taxes_shipping_at_checkout' | t }}</p>
          <div class="pw-cartpage__buttons">
            <button type="submit" name="update" class="pw-btn pw-btn--outline">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="pw-btn pw-btn--primary pw-btn--lg">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
