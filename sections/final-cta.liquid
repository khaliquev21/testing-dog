{%- liquid
  assign cta_product = section.settings.product
  if cta_product == blank
    assign cta_product = collections.all.products.first
  endif
  assign cta_url = section.settings.button_link
  if cta_url == blank
    if cta_product != blank
      assign cta_url = cta_product.url
    else
      assign cta_url = routes.all_products_collection_url
    endif
  endif
  assign fallback_media = nil
  if section.settings.product_media_position > 0 and cta_product != blank
    assign fb_index = section.settings.product_media_position | minus: 1
    assign fallback_media = cta_product.media[fb_index]
  endif
  assign show_media = false
  if section.settings.image != blank or fallback_media or request.design_mode
    assign show_media = true
  endif
-%}
<section class="pw-cta" data-section-id="{{ section.id }}">
  <div class="pw-container">
    <div class="pw-cta__box{% unless show_media %} pw-cta__box--no-media{% endunless %}">
      <div class="pw-cta__copy">
        <h2 class="pw-cta__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="pw-cta__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="pw-btn pw-btn--primary pw-btn--lg pw-cta__button" href="{{ cta_url }}">
            {{- section.settings.button_label -}}
            {%- if section.settings.show_price and cta_product != blank -%}
              <span class="pw-btn__price">{% render 'price', product: cta_product %}</span>
            {%- endif -%}
            {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.2, class: 'pw-btn__arrow' %}
          </a>
        {%- endif -%}
      </div>
      {%- if show_media -%}
        <div class="pw-cta__media">
          {% render 'media-slot',
            image: section.settings.image,
            fallback_media: fallback_media,
            label: section.settings.image_alt,
            fit: section.settings.image_fit,
            sizes: '(min-width: 990px) 480px, 100vw',
            ph_tag: 'PHOTO 06',
            ph_title: 'What is in the box',
            ph_hint: 'Genuine photo of the brush and exactly what is included.'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Closing call to action",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grooming, made simpler." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One brush with a steam mist, a self-cleaning design and an IPX7 waterproof rating — plus a shampoo in the box."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Brush" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the product below." },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use your first product." },
    { "type": "checkbox", "id": "show_price", "label": "Show the product price inside the button", "default": true },
    { "type": "header", "content": "Fallback from your Shopify product media" },
    {
      "type": "range",
      "id": "product_media_position",
      "label": "Use product media number",
      "min": 0, "max": 12, "step": 1, "default": 0,
      "info": "Used only while no photo is chosen above. 1 = the first item in the product's Media list. Pick a number whose picture truly shows this feature. 0 = off."
    },
    { "type": "header", "content": "Photo" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "What's in the box photo",
      "info": "Use a genuine photo of the brush and what is included."
    },
    { "type": "text", "id": "image_alt", "label": "Photo description (alt text)", "default": "What's in the box" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "contain", "label": "Show the whole photo" },
        { "value": "cover", "label": "Fill the frame" }
      ],
      "default": "contain"
    }
  ],
  "presets": [
    { "name": "Closing call to action" }
  ]
}
{% endschema %}
