<section class="pw-steps" data-section-id="{{ section.id }}">
  <div class="pw-steps__inner pw-container">
    <div class="pw-steps__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pw-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pw-steps__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="pw-steps__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_step_media = false
          if block.settings.image != blank or block.settings.video != blank or block.settings.video_url != blank
            assign has_step_media = true
          endif
          assign step_label = block.settings.image_alt | default: block.settings.title
          case forloop.index
            when 1
              assign step_tag = 'PHOTO 07'
              assign step_title = 'Brush in use on a dog'
            when 2
              assign step_tag = 'PHOTO 03'
              assign step_title = 'Self-cleaning feature'
            when 3
              assign step_tag = 'PHOTO 08'
              assign step_title = 'Brush in use on a cat'
            else
              assign step_tag = 'PHOTO'
              assign step_title = block.settings.title
          endcase
        -%}
        <div class="pw-step" {{ block.shopify_attributes }}>
          {%- if has_step_media or request.design_mode -%}
            <div class="pw-step__media{% unless has_step_media %} is-empty{% endunless %}">
              {% render 'media-slot',
                image: block.settings.image,
                video: block.settings.video,
                video_url: block.settings.video_url,
                label: step_label,
                fit: 'cover',
                video_size: 'sm',
                sizes: '(min-width: 990px) 400px, 100vw',
                ph_tag: step_tag,
                ph_title: step_title,
                ph_hint: 'A genuine photo, or a short looping clip of the real brush.'
              %}
            </div>
          {%- endif -%}
          <div class="pw-step__head">
            <span class="pw-step__number">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="pw-step__title">{{ block.settings.title }}</h3>
          </div>
          {%- if block.settings.text != blank -%}
            <p class="pw-step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three simple steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A genuine photo. Also used as the cover image if you add a video." },
        { "type": "video", "id": "video", "label": "Looping video (optional)", "info": "A short clip of the real brush. Loops silently with a play / pause button." },
        { "type": "text", "id": "video_url", "label": "Or direct MP4 / WebM link" },
        { "type": "text", "id": "image_alt", "label": "Description (alt text)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Brush" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Brush through your pet's coat to help lift loose fur." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Brush", "text": "Brush through your pet's coat to help lift loose fur." } },
        { "type": "step", "settings": { "title": "Clean", "text": "Use the self-cleaning design to clear the collected fur." } },
        { "type": "step", "settings": { "title": "Finish", "text": "Finish the session and put the brush away ready for next time." } }
      ]
    }
  ]
}
{% endschema %}
