{%- form 'storefront_password', class: 'pw-password__form' -%}
  {%- if form.errors -%}
    <div class="pw-contact__errors" role="alert">{{ form.errors | default_errors }}</div>
  {%- endif -%}
  <label class="pw-visually-hidden" for="PasswordInput">Password</label>
  <input id="PasswordInput" class="pw-input" type="password" name="password" autocomplete="current-password" required placeholder="Password">
  <button type="submit" class="pw-btn pw-btn--primary">Enter</button>
{%- endform -%}

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
