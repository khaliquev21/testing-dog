{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
  assign show_video_tile = false
  if has_video or request.design_mode
    assign show_video_tile = true
  endif
-%}
<section class="pw-details" data-section-id="{{ section.id }}">
  <div class="pw-details__inner pw-container">
    <div class="pw-details__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pw-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pw-details__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="pw-details__grid{% unless show_video_tile %} pw-details__grid--no-video{% endunless %}">
      {%- if show_video_tile -%}
        <div class="pw-details__video{% unless has_video %} is-empty{% endunless %}">
          {% render 'media-slot',
            video: section.settings.video,
            video_url: section.settings.video_url,
            image: section.settings.video_poster,
            label: section.settings.video_caption,
            video_size: 'lg',
            ph_kind: 'video',
            ph_tag: 'VIDEO 02',
            ph_title: 'The self-cleaning mechanism, filmed for real',
            ph_hint: 'Muted, looping MP4 with a play button. Only what the real footage shows: no added steam or fur effects.',
            ph_dark: true
          %}
          {%- if has_video and section.settings.video_caption != blank -%}
            <span class="pw-demo__caption">{{ section.settings.video_caption }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="pw-details__features">
        {%- for block in section.blocks -%}
          <div class="pw-feature" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank or request.design_mode -%}
              {%- assign feature_label = block.settings.image_alt | default: block.settings.title -%}
              {%- assign feature_slot = forloop.index | plus: 2 -%}
              {%- assign feature_tag = 'PHOTO 0' | append: feature_slot -%}
              <div class="pw-feature__media">
                {% render 'media-slot',
                  image: block.settings.image,
                  label: feature_label,
                  fit: 'cover',
                  sizes: '132px',
                  widths: '132, 264, 396',
                  ph_tag: feature_tag,
                  ph_title: block.settings.title
                %}
              </div>
            {%- endif -%}
            <div class="pw-feature__body">
              <h3 class="pw-feature__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="pw-feature__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature details",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "THE DETAILS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for Easier Grooming" },
    { "type": "header", "content": "Feature video" },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded to Shopify)",
      "info": "Genuine footage of the self-cleaning mechanism. Loops silently with a play / pause button."
    },
    { "type": "text", "id": "video_url", "label": "Or direct MP4 / WebM link", "info": "Only used if no uploaded video is chosen above." },
    { "type": "image_picker", "id": "video_poster", "label": "Cover image (optional)" },
    { "type": "text", "id": "video_caption", "label": "Caption and description", "default": "The self-cleaning mechanism" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A genuine photo that shows this feature." },
        { "type": "text", "id": "image_alt", "label": "Photo description (alt text)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Self-Cleaning Design" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Made so collected fur comes off the brush without picking it out by hand." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature details",
      "blocks": [
        { "type": "feature", "settings": { "title": "Self-Cleaning Design", "text": "Made so collected fur comes off the brush without picking it out by hand." } },
        { "type": "feature", "settings": { "title": "Steam Mist", "text": "A built-in mist function on a brush described as skin friendly." } },
        { "type": "feature", "settings": { "title": "IPX7 Waterproof", "text": "Rated IPX7 waterproof." } }
      ]
    }
  ]
}
{% endschema %}
