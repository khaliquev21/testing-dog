{%- liquid
  assign demo_product = section.settings.product
  if demo_product == blank
    assign demo_product = collections.all.products.first
  endif
  assign card_url = section.settings.card_link
  if card_url == blank
    if demo_product != blank
      assign card_url = demo_product.url
    else
      assign card_url = routes.all_products_collection_url
    endif
  endif
  assign product_videos = demo_product.media | where: 'media_type', 'video'
  assign fb_video_1 = product_videos[0]
  assign fb_video_2 = product_videos[1]
  assign fb_image = nil
  for m in demo_product.media
    if m.media_type == 'image' and fb_image == nil
      assign fb_image = m
    endif
  endfor
  assign demo_video_1 = section.settings.video_1 | default: fb_video_1
  assign demo_video_2 = section.settings.video_2 | default: fb_video_2
  assign has_video_1 = false
  if section.settings.video_1 != blank or section.settings.video_1_url != blank or fb_video_1
    assign has_video_1 = true
  endif
  assign has_video_2 = false
  if section.settings.video_2 != blank or section.settings.video_2_url != blank or fb_video_2
    assign has_video_2 = true
  endif
  assign has_footage = false
  if has_video_1 or has_video_2
    assign has_footage = true
  endif
  assign image_only = false
  if has_footage == false and fb_image
    assign image_only = true
  endif
  assign show_section = false
  if has_video_1 or has_video_2 or image_only or request.design_mode
    assign show_section = true
  endif
-%}
{%- if show_section -%}
  <section class="pw-demo" id="demo" data-section-id="{{ section.id }}">
    <div class="pw-demo__inner pw-container">
      <div class="pw-demo__head">
        <div class="pw-demo__titles">
          {%- if section.settings.eyebrow != blank and image_only == false -%}
            <span class="pw-eyebrow pw-eyebrow--light">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="pw-demo__heading">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.text != blank and image_only == false -%}
          <p class="pw-demo__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="pw-demo__grid">
        {%- if has_video_1 or image_only or request.design_mode -%}
        <div class="pw-demo__tile pw-demo__tile--main{% unless has_video_1 %} is-empty{% endunless %}">
          {% render 'media-slot',
            video: demo_video_1,
            video_url: section.settings.video_1_url,
            image: section.settings.video_1_poster,
            fallback_media: fb_image,
            label: section.settings.video_1_caption,
            video_size: 'lg',
            ph_kind: 'video',
            ph_tag: 'VIDEO 01',
            ph_title: 'The brush in use on a dog or cat',
            ph_hint: 'Genuine footage of this exact brush on a pet. Plays as a muted, looping clip with a play / pause control.',
            ph_dark: true
          %}
          {%- if has_video_1 and section.settings.video_1_caption != blank -%}
            <span class="pw-demo__caption">{{ section.settings.video_1_caption }}</span>
          {%- endif -%}
        </div>
        {%- endif -%}

        <div class="pw-demo__side">
          {%- if has_video_2 or request.design_mode -%}
          <div class="pw-demo__tile pw-demo__tile--small{% unless has_video_2 %} is-empty{% endunless %}">
            {% render 'media-slot',
              video: demo_video_2,
              video_url: section.settings.video_2_url,
              image: section.settings.video_2_poster,
              label: section.settings.video_2_caption,
              video_size: 'sm',
              ph_kind: 'video',
              ph_tag: 'VIDEO 02',
              ph_title: 'The self-cleaning mechanism',
              ph_hint: 'Only shown once real footage confirms how it works.',
              ph_dark: true
            %}
            {%- if has_video_2 and section.settings.video_2_caption != blank -%}
              <span class="pw-demo__caption">{{ section.settings.video_2_caption }}</span>
            {%- endif -%}
          </div>
          {%- endif -%}

          {%- if section.settings.card_title != blank -%}
            <div class="pw-demo__card">
              <span class="pw-demo__card-title">{{ section.settings.card_title }}</span>
              {%- if section.settings.card_text != blank -%}
                <p class="pw-demo__card-text">{{ section.settings.card_text }}</p>
              {%- endif -%}
              {%- if section.settings.card_button_label != blank -%}
                <a class="pw-btn pw-btn--primary" href="{{ card_url }}">{{ section.settings.card_button_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Demo videos",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "REAL FOOTAGE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It in Action" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The actual Pawora brush, filmed as it is — no renders, no staged effects."
    },
    { "type": "header", "content": "Main video" },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video (uploaded to Shopify)",
      "info": "Short MP4 with no sound needed. It loops silently with a play / pause button."
    },
    {
      "type": "text",
      "id": "video_1_url",
      "label": "Or direct MP4 / WebM link",
      "info": "Only used if no uploaded video is chosen above. Use a file link from Content > Files."
    },
    { "type": "image_picker", "id": "video_1_poster", "label": "Cover image (optional)" },
    { "type": "text", "id": "video_1_caption", "label": "Caption and description", "default": "The brush in use" },
    { "type": "header", "content": "Second video" },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video (uploaded to Shopify)",
      "info": "Meant for genuine footage of the self-cleaning mechanism."
    },
    { "type": "text", "id": "video_2_url", "label": "Or direct MP4 / WebM link" },
    { "type": "image_picker", "id": "video_2_poster", "label": "Cover image (optional)" },
    { "type": "text", "id": "video_2_caption", "label": "Caption and description", "default": "The self-cleaning mechanism" },
    { "type": "header", "content": "Side card" },
    { "type": "text", "id": "card_title", "label": "Title", "default": "Brush, mist, done." },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Text",
      "default": "One tool for shedding season, with a self-cleaning design for quicker clean-up afterwards."
    },
    { "type": "text", "id": "card_button_label", "label": "Button label", "default": "Shop the Brush" },
    { "type": "url", "id": "card_link", "label": "Button link", "info": "Leave empty to link to the product below." },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use your first product." }
  ],
  "presets": [
    { "name": "Demo videos" }
  ]
}
{% endschema %}
