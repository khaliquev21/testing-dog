{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign qty_id = 'Quantity-' | append: section.id
  assign media_total = product.media.size
  assign has_variants = false
  unless product.has_only_default_variant
    assign has_variants = true
  endunless

  assign max_qty = settings.max_quantity | default: 10
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
    if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity < max_qty
      assign max_qty = current_variant.inventory_quantity
    endif
  endif

  comment
    Gallery frame follows the first media item's real shape (clamped) so there is no big empty area.
  endcomment
  assign gallery_ratio = product.featured_media.preview_image.aspect_ratio | default: 1
  if gallery_ratio > 1.25
    assign gallery_ratio = 1.25
  elsif gallery_ratio < 0.8
    assign gallery_ratio = 0.8
  endif

  comment
    Bundle pricing, from real variant prices only (see snippets/variant-pricing.liquid).
  endcomment
  assign unit_price = 0
  assign bundle_mode = false
  for v in product.variants
    assign v_units = v.title | replace: '-', ' ' | split: ' ' | first | plus: 0
    if v_units == 1 and unit_price == 0
      assign unit_price = v.price
    endif
    if v_units > 1
      assign bundle_mode = true
    endif
  endfor
  if unit_price == 0
    assign unit_price = current_variant.price
  endif

  assign best_id = 0
  assign best_save = 0
  for v in product.variants
    capture vp_text
      render 'variant-pricing', variant: v, unit_price: unit_price
    endcapture
    assign vp_bits = vp_text | split: '|'
    assign vp_u = vp_bits[0] | plus: 0
    assign vp_s = vp_bits[2] | plus: 0
    if vp_u > 1 and vp_s > best_save
      assign best_save = vp_s
      assign best_id = v.id
    endif
  endfor

  capture cur_text
    render 'variant-pricing', variant: current_variant, unit_price: unit_price
  endcapture
  assign cur_bits = cur_text | split: '|'
  assign cur_compare = cur_bits[1] | plus: 0
  assign cur_units = cur_bits[0] | plus: 0

  assign low_stock_limit = section.settings.low_stock_threshold | default: 0
  assign stock_left = 0
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_limit
    assign stock_left = current_variant.inventory_quantity
  endif
-%}

{%- if section.settings.show_breadcrumb -%}
  <nav class="pw-breadcrumb pw-container" aria-label="{{ 'product.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.all_products_collection_url }}">{{ 'collection.title' | t }}</a>
    <span aria-hidden="true">/</span>
    <span class="pw-breadcrumb__current">{{ product.title }}</span>
  </nav>
{%- endif -%}

<section class="pw-product" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="pw-product__grid pw-container">

    {%- comment -%} ---------- Gallery: real Shopify product media ---------- {%- endcomment -%}
    <product-gallery class="pw-gallery" style="--gallery-ratio: {{ gallery_ratio }}" data-autoplay="{{ section.settings.autoplay_videos }}" data-total="{{ media_total }}">
      <div class="pw-gallery__stage" role="group" aria-roledescription="carousel" aria-label="{{ 'accessibility.product_media' | t }}">
        {%- if media_total > 0 -%}
          <div class="pw-gallery__slides" data-gallery-slides>
            {%- for media in product.media -%}
              <div
                class="pw-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-gallery-slide
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="{{ media.media_type }}"
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
              >
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- assign slide_alt = media.alt | default: product.title -%}
                    {%- if forloop.first -%}
                      {{
                        media
                        | image_url: width: 1600
                        | image_tag: widths: '500, 700, 900, 1200, 1600', sizes: '(min-width: 990px) 560px, 100vw', loading: 'eager', fetchpriority: 'high', alt: slide_alt, class: 'pw-media__img pw-fit--contain'
                      }}
                    {%- else -%}
                      {{
                        media
                        | image_url: width: 1600
                        | image_tag: widths: '500, 700, 900, 1200, 1600', sizes: '(min-width: 990px) 560px, 100vw', loading: 'lazy', alt: slide_alt, class: 'pw-media__img pw-fit--contain'
                      }}
                    {%- endif -%}
                  {%- when 'video' -%}
                    {%- assign video_label = media.alt | default: product.title -%}
                    {% render 'loop-video',
                      video: media,
                      label: video_label,
                      size: 'lg',
                      max_height: 1080,
                      class: 'pw-media__fill'
                    %}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- else -%}
                    {{ media | media_tag: image_size: '1100x' }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if media_total > 1 -%}
            <button type="button" class="pw-gallery__arrow pw-gallery__arrow--prev" data-gallery-prev aria-label="{{ 'accessibility.previous_image' | t }}">
              {% render 'icon', name: 'chevron-left', size: 20, stroke: 2 %}
            </button>
            <button type="button" class="pw-gallery__arrow pw-gallery__arrow--next" data-gallery-next aria-label="{{ 'accessibility.next_image' | t }}">
              {% render 'icon', name: 'chevron-right', size: 20, stroke: 2 %}
            </button>
            <span class="pw-gallery__counter" aria-live="polite"><span data-gallery-current>1</span> / {{ media_total }}</span>
          {%- endif -%}
        {%- else -%}
          <div class="pw-gallery__empty">
            {%- if request.design_mode -%}
              {% render 'placeholder-slot',
                kind: 'photo',
                tag: 'PRODUCT GALLERY',
                title: 'Add your genuine product photos and videos to this product in Shopify admin',
                hint: 'Order: 01 main image, 02 bristle close-up, 03 self-cleaning, 04 mist and water tank, 05 IPX7, 06 in the box, 07 dog lifestyle, 08 cat lifestyle, then the looping videos.'
              %}
            {%- else -%}
              {% render 'icon', name: 'paw', size: 64, class: 'pw-gallery__empty-mark' %}
              <span class="pw-gallery__empty-text">{{ 'product.no_media' | t }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if media_total > 1 -%}
        <div class="pw-gallery__thumbs" role="group" aria-label="{{ 'accessibility.product_media' | t }}">
          {%- for media in product.media -%}
            <button
              type="button"
              class="pw-thumb{% if media.media_type != 'image' %} pw-thumb--video{% endif %}{% if forloop.first %} is-active{% endif %}"
              data-gallery-thumb
              data-index="{{ forloop.index0 }}"
              data-media-id="{{ media.id }}"
              aria-label="{{ 'accessibility.show_media' | t: position: forloop.index, total: media_total }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{
                media.preview_image
                | image_url: width: 160, height: 160
                | image_tag: width: 80, height: 80, loading: 'lazy', alt: '', class: 'pw-thumb__img'
              }}
              {%- if media.media_type != 'image' -%}
                <span class="pw-thumb__play">{% render 'icon', name: 'play', size: 14 %}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-gallery>

    {%- comment -%} ---------- Product information and purchase ---------- {%- endcomment -%}
    <div class="pw-product__info" id="ProductInfo-{{ section.id }}">
      <div class="pw-product__heading">
        <span class="pw-eyebrow">{{ brand | upcase }}</span>
        <h1 class="pw-product__title">{{ product.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="pw-product__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="pw-product__price" data-product-price>
        {% render 'price', product: product, variant: current_variant, compare: cur_compare, show_save: true %}
      </div>

      {%- if section.settings.description_source == 'product' and product.description != blank -%}
        <div class="pw-product__desc rte">{{ product.description }}</div>
      {%- elsif section.settings.description != blank -%}
        <p class="pw-product__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
      {%- if benefit_blocks.size > 0 -%}
        <ul class="pw-checklist pw-checklist--compact">
          {%- for block in benefit_blocks -%}
            <li class="pw-checklist__item" {{ block.shopify_attributes }}>
              <span class="pw-checklist__mark">{% render 'icon', name: 'check', size: 14, stroke: 2.8 %}</span>
              <span class="pw-checklist__text">{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <product-form class="pw-buy" data-max="{{ max_qty }}" data-form-id="{{ form_id }}"{% if bundle_mode %} data-bundle{% endif %}>
        {%- form 'product', product, id: form_id, class: 'pw-buy__form', novalidate: 'novalidate' -%}
          {%- if has_variants -%}
            <fieldset class="pw-variants">
              <legend class="pw-buy__label">{{ section.settings.variant_label | default: product.options_with_values.first.name }}</legend>
              <div class="pw-variants__grid">
                {%- for variant in product.variants -%}
                  {%- liquid
                    capture card_text
                      render 'variant-pricing', variant: variant, unit_price: unit_price
                    endcapture
                    assign card_bits = card_text | split: '|'
                    assign card_compare = card_bits[1] | plus: 0
                    assign card_save = card_bits[2] | plus: 0
                    assign card_save_amount = card_save | money
                    assign show_badge = false
                    if section.settings.badge_text != blank
                      if section.settings.badge_variant != blank
                        if section.settings.badge_variant == variant.title
                          assign show_badge = true
                        endif
                      elsif variant.id == best_id
                        assign show_badge = true
                      endif
                    endif
                  -%}
                  {%- assign card_units = card_bits[0] | plus: 0 -%}
                  <label class="pw-variant{% if variant == current_variant %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}{% if show_badge %} has-badge{% endif %}">
                    <input class="pw-variant__input" type="radio" name="id" value="{{ variant.id }}" data-variant-input data-units="{{ card_units }}"{% if variant == current_variant %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    {%- if show_badge -%}
                      <span class="pw-variant__badge">{{ section.settings.badge_text }}</span>
                    {%- endif -%}
                    <span class="pw-variant__titlebar">
                      <span class="pw-variant__check" aria-hidden="true"></span>
                      <span class="pw-variant__title">{{ variant.title }}</span>
                    </span>
                    {%- if bundle_mode -%}
                      <span class="pw-variant__units">{{ 'product.bundle_units' | t: count: card_units, brand: brand }}</span>
                    {%- endif -%}
                    <span class="pw-variant__price">
                      {%- if settings.show_currency_code -%}{{ variant.price | money_with_currency }}{%- else -%}{{ variant.price | money }}{%- endif -%}
                    </span>
                    {%- if card_save > 0 -%}
                      <span class="pw-variant__was"><s>{{ card_compare | money }}</s></span>
                      <span class="pw-variant__save">{{ 'product.save' | t: amount: card_save_amount }}</span>
                    {%- endif -%}
                    {%- if bundle_mode and card_units > 1 and section.settings.bundle_copy != blank -%}
                      <span class="pw-variant__copy">{{ section.settings.bundle_copy }}</span>
                    {%- endif -%}
                    {%- unless variant.available -%}
                      <span class="pw-variant__note">{{ 'product.sold_out' | t }}</span>
                    {%- endunless -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
            {%- if request.design_mode -%}
              <p class="pw-acc__todo">Bundle cards are hidden because this product has only one variant. In Shopify admin, open the product and add an option "Pack size" with the values "1 Pack" and "2 Pack", then set each price. They appear here automatically. Shoppers do not see this note.</p>
            {%- endif -%}
          {%- endif -%}

          {%- if bundle_mode -%}
            <label class="pw-buy__label" for="{{ qty_id }}">{{ 'product.quantity_brushes' | t }}</label>
          {%- else -%}
            <label class="pw-buy__label" for="{{ qty_id }}">{{ 'product.quantity' | t }}</label>
          {%- endif -%}
          <div class="pw-buy__row">
            <div class="pw-qty">
              <button type="button" class="pw-qty__btn" data-qty-minus aria-label="{{ 'accessibility.decrease_quantity' | t }}">
                {% render 'icon', name: 'minus', size: 18, stroke: 2.2 %}
              </button>
              {%- if bundle_mode -%}
                {%- comment -%}
                  Bundle mode: the box shows how many brushes the selected option contains. It is display only.
                  The cart quantity is always 1 of the selected bundle variant, so Shopify's own variant price is charged.
                {%- endcomment -%}
                <input id="{{ qty_id }}" class="pw-qty__input" type="text" value="{{ cur_units }}" readonly data-qty-display aria-live="polite">
                <input type="hidden" name="quantity" value="1" data-qty-input>
              {%- else -%}
                <input
                  id="{{ qty_id }}"
                  class="pw-qty__input"
                  type="text"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  name="quantity"
                  value="1"
                  data-qty-input
                  autocomplete="off"
                >
              {%- endif -%}
              <button type="button" class="pw-qty__btn" data-qty-plus aria-label="{{ 'accessibility.increase_quantity' | t }}">
                {% render 'icon', name: 'plus', size: 18, stroke: 2.2 %}
              </button>
            </div>

            <button
              type="submit"
              name="add"
              class="pw-btn pw-btn--primary pw-buy__submit"
              data-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {% render 'icon', name: 'bag', size: 20, stroke: 2, class: 'pw-buy__bag' %}
              <span data-add-label>
                {%- if current_variant.available -%}
                  {{ 'product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'product.sold_out' | t }}
                {%- endif -%}
              </span>
              <span class="pw-buy__price" data-add-price{% unless current_variant.available %} hidden{% endunless %}>
                {%- if settings.show_currency_code -%}{{ current_variant.price | money_with_currency }}{%- else -%}{{ current_variant.price | money }}{%- endif -%}
              </span>
            </button>
          </div>
          <p class="pw-buy__stock" data-stock-note{% if stock_left == 0 %} hidden{% endif %}>
            {%- if stock_left > 0 -%}{{ 'product.low_stock' | t: count: stock_left }}{%- endif -%}
          </p>
          <p class="pw-buy__error" role="alert" data-form-error hidden></p>
        {%- endform -%}

        {%- if has_variants -%}
          <script type="application/json" data-variants-json>
            [
              {%- for variant in product.variants -%}
                {%- liquid
                  capture json_text
                    render 'variant-pricing', variant: variant, unit_price: unit_price
                  endcapture
                  assign json_bits = json_text | split: '|'
                  assign json_compare = json_bits[1] | plus: 0
                  assign json_save = json_bits[2] | plus: 0
                  assign json_save_amount = json_save | money
                -%}
                {
                  "id": {{ variant.id }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | json }},
                  "priceFormatted": {% if settings.show_currency_code %}{{ variant.price | money_with_currency | json }}{% else %}{{ variant.price | money | json }}{% endif %},
                  "compareFormatted": {% if json_save > 0 %}{{ json_compare | money | json }}{% else %}""{% endif %},
                  "saveFormatted": {% if json_save > 0 %}{{ 'product.save' | t: amount: json_save_amount | json }}{% else %}""{% endif %},
                  "mediaId": {{ variant.featured_media.id | json }},
                  "stock": {% if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock_limit %}{{ variant.inventory_quantity }}{% else %}0{% endif %},
                  "max": {% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity < settings.max_quantity %}{{ variant.inventory_quantity }}{% else %}{{ settings.max_quantity }}{% endif %}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {%- endif -%}
      </product-form>

      {%- assign perk_blocks = section.blocks | where: 'type', 'perk' -%}
      {%- if perk_blocks.size > 0 -%}
        <ul class="pw-perks">
          {%- for block in perk_blocks -%}
            <li class="pw-perk" {{ block.shopify_attributes }}>
              <span class="pw-perk__icon">{% render 'icon', name: block.settings.icon, size: 22, stroke: 1.8 %}</span>
              <span class="pw-perk__title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="pw-perk__text">{{ block.settings.text }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign info_blocks = section.blocks | where: 'type', 'info_row' -%}
      {%- if info_blocks.size > 0 -%}
        <info-accordion class="pw-inforows">
          {%- for block in info_blocks -%}
            {% render 'info-accordion-row', block: block, section_id: section.id, index: forloop.index %}
          {%- endfor -%}
        </info-accordion>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="pw-product__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<div class="pw-sticky" data-sticky-bar hidden>
  <div class="pw-sticky__info">
    <span class="pw-sticky__title">{{ product.title }}</span>
    <span class="pw-sticky__price" data-price>
      {%- if settings.show_currency_code -%}{{ current_variant.price | money_with_currency }}{%- else -%}{{ current_variant.price | money }}{%- endif -%}
    </span>
  </div>
  <button type="submit" form="{{ form_id }}" class="pw-btn pw-btn--primary pw-sticky__button" data-sticky-button{% unless current_variant.available %} disabled{% endunless %}>
    {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
  </button>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "header", "content": "Gallery" },
    {
      "type": "checkbox",
      "id": "autoplay_videos",
      "label": "Play product videos automatically",
      "default": true,
      "info": "Videos play muted and loop, with a play / pause button. They stay paused for shoppers who prefer reduced motion."
    },
    { "type": "header", "content": "Bundle / option cards" },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Heading above the option cards",
      "default": "Choose your bundle",
      "info": "Cards are built from the product's real Shopify variants and prices. They only appear if the product has more than one variant."
    },
    {
      "type": "text",
      "id": "badge_variant",
      "label": "Variant to highlight (exact variant name)",
      "info": "Leave empty to automatically badge the bundle with the biggest real saving."
    },
    { "type": "text", "id": "badge_text", "label": "Highlight badge text", "default": "BEST VALUE" },
    { "type": "text", "id": "bundle_copy", "label": "Supporting line on multi-brush bundles", "default": "Keep a spare or groom more than one pet." },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Show \"only a few left\" at or below",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 5,
      "info": "Uses the real inventory count when Shopify tracks it. Set to 0 to turn off."
    },
    { "type": "header", "content": "Text" },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Line under the title",
      "default": "Steam mist brush · For dogs & cats · Short or long hair"
    },
    {
      "type": "select",
      "id": "description_source",
      "label": "Description",
      "options": [
        { "value": "text", "label": "Use the short text below" },
        { "value": "product", "label": "Use the product description from Shopify" }
      ],
      "default": "text"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short description",
      "default": "A deshedding brush with a built-in steam mist and a self-cleaning design. Rated IPX7 waterproof and described as skin friendly, it's made for dogs and cats with short or long hair."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the policy box",
      "default": "In the box: 1 brush, 1 shampoo.",
      "info": "Confirm what is really in the box before you launch. Leave empty to hide."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Check-list item",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Helps remove loose fur from short and long coats" }
      ]
    },
    {
      "type": "perk",
      "name": "Benefit tile",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "fur", "label": "Brush bristles" },
            { "value": "refresh", "label": "Self-cleaning arrows" },
            { "value": "mist", "label": "Mist" },
            { "value": "drop", "label": "Water drop" },
            { "value": "check", "label": "Check mark" },
            { "value": "paw", "label": "Paw" }
          ],
          "default": "fur"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Helps remove loose fur" },
        { "type": "text", "id": "text", "label": "Short text" }
      ]
    },
    {
      "type": "info_row",
      "name": "Info accordion row",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "Row type",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "custom",
              "label": "Other"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "check",
              "label": "Check mark"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short line under the title",
          "default": "Delivery details and costs"
        },
