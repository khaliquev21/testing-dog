{%- liquid
  assign intro_product = section.settings.product
  if intro_product == blank
    assign intro_product = collections.all.products.first
  endif
  assign cta_url = section.settings.button_link
  if cta_url == blank
    if intro_product != blank
      assign cta_url = intro_product.url
    else
      assign cta_url = routes.all_products_collection_url
    endif
  endif
  assign fallback_media = nil
  if section.settings.product_media_position > 0 and intro_product != blank
    assign fb_index = section.settings.product_media_position | minus: 1
    assign fallback_media = intro_product.media[fb_index]
  endif
  assign fallback_media_2 = nil
  if section.settings.product_media_position_2 > 0 and intro_product != blank
    assign fb_index_2 = section.settings.product_media_position_2 | minus: 1
    assign fallback_media_2 = intro_product.media[fb_index_2]
  endif
  assign has_main = false
  if section.settings.image != blank or fallback_media
    assign has_main = true
  endif
  assign has_second = false
  if section.settings.image_2 != blank or fallback_media_2
    assign has_second = true
  endif
  assign show_media = false
  if has_main or has_second or request.design_mode
    assign show_media = true
  endif
-%}
<section class="pw-intro{% unless show_media %} pw-intro--no-media{% endunless %}" data-section-id="{{ section.id }}">
  <div class="pw-intro__inner pw-container">
    {%- if show_media -%}
      <div class="pw-intro__media">
        <div class="pw-intro__main">
          {% render 'media-slot',
            image: section.settings.image,
            fallback_media: fallback_media,
            label: section.settings.image_alt,
            fit: section.settings.image_fit,
            sizes: '(min-width: 990px) 560px, 100vw',
            ph_tag: 'PHOTO 02',
            ph_title: 'Close-up of the bristles and brush head',
            ph_hint: 'Your genuine close-up photo of the bristles and brush head.'
          %}
        </div>
        {%- if has_second or request.design_mode -%}
          <div class="pw-intro__inset">
            {% render 'media-slot',
              image: section.settings.image_2,
              fallback_media: fallback_media_2,
              label: section.settings.image_2_alt,
              fit: 'cover',
              sizes: '230px',
              ph_tag: 'PHOTO 07',
              ph_title: 'Supplier lifestyle shot: brush on a dog'
            %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pw-intro__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pw-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pw-intro__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="pw-intro__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="pw-checklist">
          {%- for block in section.blocks -%}
            <li class="pw-checklist__item" {{ block.shopify_attributes }}>
              <span class="pw-checklist__mark">{% render 'icon', name: 'check', size: 15, stroke: 2.8 %}</span>
              <span class="pw-checklist__text">
                {%- if block.settings.strong != blank -%}<strong>{{ block.settings.strong }}</strong>{%- endif -%}
                {{ block.settings.text }}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="pw-btn pw-btn--primary pw-btn--lg" href="{{ cta_url }}">
          {{- section.settings.button_label -}}
          {%- if section.settings.show_price and intro_product != blank -%}
            <span class="pw-btn__price">{% render 'price', product: intro_product %}</span>
          {%- endif -%}
          {% render 'icon', name: 'arrow-right', size: 18, stroke: 2.2, class: 'pw-btn__arrow' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product introduction",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Photos" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main photo",
      "info": "A genuine close-up of the bristles and brush head."
    },
    { "type": "text", "id": "image_alt", "label": "Main photo description (alt text)", "default": "Close-up of the Pawora brush head and bristles" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Main photo fit",
      "options": [
        { "value": "cover", "label": "Fill the frame" },
        { "value": "contain", "label": "Show the whole photo" }
      ],
      "default": "cover"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Small overlapping photo",
      "info": "A genuine lifestyle photo, only if you have one. Hidden on mobile."
    },
    { "type": "text", "id": "image_2_alt", "label": "Small photo description (alt text)" },
    { "type": "header", "content": "Fallback from your Shopify product media" },
    {
      "type": "range",
      "id": "product_media_position",
      "label": "Main photo: use product media number",
      "min": 0, "max": 12, "step": 1, "default": 0,
      "info": "Used only while no photo is chosen above. 1 = the first item in the product's Media list. Pick a number whose picture truly shows this feature. 0 = off."
    },
    {
      "type": "range", "id": "product_media_position_2", "label": "Small photo: use product media number",
      "min": 0, "max": 12, "step": 1, "default": 0,
      "info": "Same idea for the small overlapping photo. 0 = off."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "MEET THE BRUSH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Simpler Grooming Routine" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The Pawora Self-Cleaning Pet Grooming Brush pairs a deshedding brush with a built-in steam mist. It's made for dogs and cats with short or long hair, and arrives with one shampoo to get you started."
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Brush" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to link to the product below." },
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty to use your first product." },
    { "type": "checkbox", "id": "show_price", "label": "Show the product price inside the button", "default": true }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Check-list item",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "strong", "label": "Bold words", "default": "Helps remove loose fur" },
        { "type": "text", "id": "text", "label": "Rest of the sentence", "default": "from short and long coats during shedding season." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product introduction",
      "blocks": [
        { "type": "point", "settings": { "strong": "Helps remove loose fur", "text": "from short and long coats during shedding season." } },
        { "type": "point", "settings": { "strong": "Self-cleaning design", "text": "for quicker clean-up after every session." } },
        { "type": "point", "settings": { "strong": "IPX7 waterproof", "text": "and described as skin friendly." } }
      ]
    }
  ]
}
{% endschema %}
